class Solution {
    public void helper(TreeNode root,
                       String path,
                       List<String> ans) {

        if(root == null) {
            return;
        }

        if(path.length() == 0) {
            path = path + root.val;
        }
        else {
            path = path + "->" + root.val;
        }

        // leaf node
        if(root.left == null && root.right == null) {
            ans.add(path);
            return;
        }

        helper(root.left, path, ans);
        helper(root.right, path, ans);
    }

    public List<String> binaryTreePaths(TreeNode root) {

        List<String> ans = new ArrayList<>();

        helper(root, "", ans);

        return ans;
    }
}
